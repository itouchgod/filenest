{
  "name": "filenest",
  "version": "0.1.0",
  "description": "A macOS desktop app for organizing and opening favorite folders.",
  "main": "dist-electron/electron/main.js",
  "author": "itouchgod",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://127.0.0.1:5173 dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:web": "tsc --noEmit && vite build",
    "build": "tsc --noEmit && tsc -p tsconfig.electron.json && vite build",
    "start": "npm run build && electron .",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "package:mac:arm64": "npm run build && node scripts/package-mac.mjs --arch=arm64",
    "package:mac:x64": "npm run build && node scripts/package-mac.mjs --arch=x64",
    "package:dmg": "npm run package:mac:arm64 && node scripts/create-dmg.mjs --arch=arm64",
    "package:dmg:arm64": "npm run package:mac:arm64 && node scripts/create-dmg.mjs --arch=arm64",
    "package:dmg:x64": "npm run package:mac:x64 && node scripts/create-dmg.mjs --arch=x64",
    "package:release": "node scripts/package-release.mjs"
  },
  "build": {
    "appId": "com.itouchgod.filenest",
    "productName": "FileNest",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ]
    },
    "asar": true
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1"
  }
}
